DEBUG=True
SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=noctis_pro.settings
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=*,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-domain.com
SECURE_SSL_REDIRECT=False

# HTTPS reverse proxy
DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com

# Optional: collect static on container start
# COLLECTSTATIC=1
