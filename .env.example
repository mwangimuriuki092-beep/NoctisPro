# Django Configuration
DEBUG=False
SECRET_KEY=your-secret-key-will-be-generated-automatically

# Domain and Security Settings
DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=False

# ACME/Let's Encrypt (for HTTPS)
ACME_EMAIL=admin@example.com

# Database Configuration (SQLite default, PostgreSQL recommended for production)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: DATABASE_URL=postgres://username:password@localhost:5432/dbname
POSTGRES_DB=noctis_pro
POSTGRES_USER=noctis_user
POSTGRES_PASSWORD=your-postgres-password-will-be-generated

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Static Files
COLLECTSTATIC=1
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# PageKite Configuration (for external HTTPS access without port forwarding)
PAGEKITE_ENABLE=0
PAGEKITE_SUBDOMAIN=your-subdomain
PAGEKITE_EMAIL=your-email@example.com
PAGEKITE_SECRET=your-pagekite-secret

# Admin User Configuration (will be created automatically)
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password-will-be-generated

# Application Settings
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# Logging
LOG_LEVEL=INFO

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production email:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# File Upload Settings
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800  # 50MB
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800  # 50MB