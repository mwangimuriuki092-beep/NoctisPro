[Unit]
Description=Noctis Celery Worker - Production
After=network.target redis-server.service postgresql.service
Wants=redis-server.service postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/noctis
Environment=DJANGO_SETTINGS_MODULE=noctis_pro.settings
EnvironmentFile=/opt/noctis/.env
ExecStart=/opt/noctis/.venv/bin/celery -A noctis_pro worker --loglevel=info --concurrency=4 --max-tasks-per-child=1000
ExecReload=/bin/kill -HUP $MAINPID
User=www-data
Group=www-data
Restart=on-failure
RestartSec=15
KillMode=mixed
TimeoutStopSec=60

# Production resource limits for 5GB DICOM processing
MemoryMax=8G
MemoryHigh=6G
CPUQuota=400%
TasksMax=3000

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/noctis/media /opt/noctis/logs /var/log/noctis /tmp
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

# File limits for very large DICOM processing (5GB)
LimitNOFILE=65536
LimitMEMLOCK=256M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=noctis-worker

[Install]
WantedBy=multi-user.target

