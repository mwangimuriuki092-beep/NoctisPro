[Unit]
Description=Noctis Django (Daphne) - Production
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/noctis
Environment=DJANGO_SETTINGS_MODULE=noctis_pro.settings
EnvironmentFile=/opt/noctis/.env
ExecStart=/opt/noctis/.venv/bin/daphne -b 0.0.0.0 -p 8000 --proxy-headers noctis_pro.asgi:application
ExecReload=/bin/kill -HUP $MAINPID
User=www-data
Group=www-data
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

# Production resource limits (increased for 5GB file handling)
MemoryMax=4G
MemoryHigh=3G
CPUQuota=300%
TasksMax=2000

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/noctis/media /opt/noctis/logs /var/log/noctis
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

# File limits for large DICOM uploads
LimitNOFILE=65536
LimitMEMLOCK=64M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=noctis-web

[Install]
WantedBy=multi-user.target

